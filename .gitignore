# Only curated model artifacts may use these data-like formats. Re-include the
# parent directories so the exceptions also work if an ignored models/ rule is
# introduced by a global or parent ignore file.
!models/
!models/**/
!models/**/*.csv
!models/**/*.json
*.pt
*.pth
!models/**/*.pt
!models/**/*.pth

